{"step_index":126,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-13T07:07:50Z","thinking":"Static page generation is complete, and dynamic server errors are resolved. Awaiting task completion notification. Proceeding to develop an end-to-end API integration test script. The script will cover user registration, login, user information retrieval, chat creation, and streamed message testing.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"// Automated E2E verification test for UMGN API endpoints\nconst BASE_URL = \"http://localhost:3000\";\n\nasync function runTests() {\n  console.log(\"=== Starting UMGN Automated Integration Tests ===\");\n\n  const testEmail = `testuser_${Date.now()}@example.com`;\n  const testUsername = `user_${Date.now()}`;\n  const testPassword = \"Password123!\";\n\n  let sessionCookie = \"\";\n\n  // 1. Register\n  console.log(\"\\n[1/7] Testing Registration...\");\n  const regRes = await fetch(`${BASE_URL}/api/auth/register`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({\n      email: testEmail,\n      username: testUsername,\n      password: testPassword,\n    }),\n  });\n\n  const regData = await regRes.json();\n  if (!regRes.ok) {\n    throw new Error(`Register failed: ${JSON.stringify(regData)}`);\n  }\n  console.log(\"✓ Registration succeeded:\", regData.user.username);\n\n  // Extract set-cookie\n  const setCookie = regRes.headers.get(\"set-cookie\");\n  if (setCookie) {\n    sessionCookie = setCookie.split(\";\")[0];\n  }\n\n  // 2. Auth Me Session Check\n  console.log(\"\\n[2/7] Testing Session Verification (/api/auth/me)...\");\n  const meRes = await fetch(`${BASE_URL}/api/auth/me`, {\n    headers: { Cookie: sessionCookie },\n  });\n  const meData = await meRes.json();\n  if (!meRes.ok || !meData.user) {\n    throw new Error(`Session check failed: ${JSON.stringify(meData)}`);\n  }\n  console.log(\"✓ Session verified for user ID:\", meData.user.id);\n\n  // 3. Create Chat\n  console.log(\"\\n[3/7] Testing Chat Creation (/api/chats)...\");\n  const chatRes = await fetch(`${BASE_URL}/api/chats`, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Cookie: sessionCookie,\n    },\n    body: JSON.stringify({ title: \"Integration Test Chat\" }),\n  });\n  const chatData = await chatRes.json();\n  if (!chatRes.ok || !chatData.chat) {\n    throw new Error(`Chat creation failed: ${JSON.stringify(chatData)}`);\n  }\n  const chatId = chatData.chat.id;\n  console.log(\"✓ Chat created with ID:\", chatId);\n\n  // 4. Send & Stream Message\n  console.log(\"\\n[4/7] Testing Chat Streaming (/api/chat/stream)...\");\n  const streamRes = await fetch(`${BASE_URL}/api/chat/stream`, {\n    method: \"POST\",\n    headers: {\n      \"Content-Type\": \"application/json\",\n      Cookie: sessionCookie,\n    },\n    body: JSON.stringify({\n      chatId,\n      content: \"Hello UMGN, can you verify your architecture?\",\n    }),\n  });\n\n  if (!streamRes.ok) {\n    const errText = await streamRes.text();\n    throw new Error(`Stream failed: ${errText}`);\n  }\n\n  const streamText = await streamRes.text();\n  console.log(`✓ Received streamed response (${streamText.length} bytes):`);\n  console.log(`Preview: \"${streamText.slice(0, 100).replace(/\\n/g, \" \")}...\"`);\n\n  // 5. Data Export (GDPR)\n  console.log(\"\\n[5/7] Testing Data Export (/api/user/export)...\");\n  const exportRes = await fetch(`${BASE_URL}/api/user/export`, {\n    headers: { Cookie: sessionCookie },\n  });\n  if (!exportRes.ok) {\n    throw new Error(\"Data export failed\");\n  }\n  const exportJson = await exportRes.json();\n  console.log(`✓ Data exported successfully! Contained ${exportJson.totalChats} chat(s) and ${exportJson.totalMessages} message(s).`);\n\n  // 6. Clear Chats\n  console.log(\"\\n[6/7] Testing Clear Chats (/api/user/chats)...\");\n  const clearRes = await fetch(`${BASE_URL}/api/user/chats`, {\n    method: \"DELETE\",\n    headers: { Cookie: sessionCookie },\n  });\n  const clearData = await clearRes.json();\n  console.log(\"✓ Clear chats result:\", clearData.message);\n\n  // 7. Delete Account\n  console.log(\"\\n[7/7] Testing Permanent Account Deletion (/api/user/account)...\");\n  const deleteRes = await fetch(`${BASE_URL}/api/user/account`, {\n    method: \"DELETE\",\n    headers: { Cookie: sessionCookie },\n  });\n  const deleteData = await deleteRes.json();\n  console.log(\"✓ Account deletion result:\", deleteData.message);\n\n  console.log(\"\\n=======================================================\");\n  console.log(\"🎉 ALL INTEGRATION TESTS PASSED SUCCESSFULLY! (7/7)\");\n  console.log(\"=======================================================\");\n}\n\nrunTests().catch((err) => {\n  console.error(\"❌ Test failed:\", err);\n  process.exit(1);\n});\n","Description":"Create automated end-to-end integration test script","Overwrite":true,"TargetFile":"c:\\Users\\LENOVO\\Documents\\ud\\scripts\\test-api.mjs","toolAction":"Creating test-api.mjs","toolSummary":"Automated integration test script"}}]}
